# Base URL of the HPLPGA API (FastAPI). All calls go to <url>/api/v1/...
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk authentication (https://dashboard.clerk.com → API keys). Put real values in .env.local, never commit them.
# Without the publishable key the store runs guest-only and shows "Sign-in isn't configured yet".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Server-only secret (used by middleware.ts); never prefix it with NEXT_PUBLIC_.
CLERK_SECRET_KEY=sk_test_your_secret_key
