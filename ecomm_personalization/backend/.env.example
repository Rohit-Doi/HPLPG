# Copy to backend/.env and fill in what you have. Every key is optional; the store runs without any of them.

# --- Database -------------------------------------------------------------
# Unset = SQLite file at backend/artifacts/store.db (zero setup, good for local use).
# PostgreSQL (recommended for deployment). Keep the "postgresql+psycopg://" prefix:
# HPLPGA_DATABASE_URL=postgresql+psycopg://aura:aura@localhost:5432/aura

# --- Sign-in: Clerk ---------------------------------------------------------
# In development these are read automatically from project/.env.local (written by `npx clerk init`).
# In production set them here (same values the storefront uses).
# CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...

# --- Payments: Razorpay (test keys work on localhost; unset = simulated payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Email (unset = messages are written to artifacts/outbox.log) -----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: Claude-written hero copy (templates are used when unset) ----
ANTHROPIC_API_KEY=
HPLPGA_LLM_MODEL=claude-opus-5

# --- Runtime --------------------------------------------------------------
# Storefront address(es) allowed to call the API and to send Clerk sessions (localhost is always allowed).
# Production: your Vercel URL, e.g. https://aura-store.vercel.app (comma-separate several).
HPLPGA_CORS_ORIGINS=http://localhost:3000
# Optional pattern for changing URLs such as Vercel preview deployments:
# HPLPGA_CORS_ORIGIN_REGEX=https://aura-store-[a-z0-9-]+-yourname\.vercel\.app
